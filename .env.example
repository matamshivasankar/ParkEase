# ParkEase environment variables.
# Copy to `.env` for local development: `cp .env.example .env`
# (Flask does not load .env automatically unless python-dotenv is used, so
#  either export these in your shell or load the file before running.)

# ---------------------------------------------------------------------------
# Flask
# ---------------------------------------------------------------------------
# development | production | testing
FLASK_ENV=development

# CHANGE THESE IN PRODUCTION. Used to sign sessions and JWTs.
SECRET_KEY=dev-secret-key-change-me
JWT_SECRET_KEY=dev-jwt-secret-key-change-me

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Local default is SQLite (stored in backend/instance/parkease.db).
# On Render this is injected automatically from the managed Postgres instance.
DATABASE_URL=sqlite:///parkease.db

# ---------------------------------------------------------------------------
# CORS / frontend origin
# ---------------------------------------------------------------------------
# Comma-separated list. Leave unset locally; on Render the public URL is added
# automatically. Set it explicitly only for a custom domain or separate frontend.
# CORS_ORIGINS=https://parkease.onrender.com

# ---------------------------------------------------------------------------
# Pricing / business rules
# ---------------------------------------------------------------------------
LOCAL_TIMEZONE=Asia/Kolkata

# ---------------------------------------------------------------------------
# Payments (UPI)
# ---------------------------------------------------------------------------
# Merchant VPA embedded in the generated UPI QR code (demo default if unset).
MERCHANT_UPI=6305898891@upi
MERCHANT_NAME=ParkEase

# ---------------------------------------------------------------------------
# Storage (optional)
# ---------------------------------------------------------------------------
# Point runtime files at a persistent volume so uploads survive redeploys.
# All four folders derive from DATA_DIR unless individually overridden.
# DATA_DIR=/var/data
# UPLOAD_FOLDER=/var/data/uploads
# RECEIPT_FOLDER=/var/data/receipts
# QR_CODE_FOLDER=/var/data/qr_codes
# SCREENSHOT_FOLDER=/var/data/screenshots

# ---------------------------------------------------------------------------
# Rate limiting (optional)
# ---------------------------------------------------------------------------
# RATELIMIT_DEFAULT=200 per minute
# Use a shared backend (e.g. redis://...) if you ever run multiple instances.
# RATELIMIT_STORAGE_URL=memory://
